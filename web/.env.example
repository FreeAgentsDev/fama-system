# URL del server de Iraca (server/). En prod (Railway) cambia por la URL pública.
# Debe ser la misma en ambas variables; NEXT_PUBLIC_ va al bundle del navegador.
IRACA_URL=http://localhost:2436
NEXT_PUBLIC_IRACA_URL=http://localhost:2436

# URL pública del frontend, usada como `redirect-url` del checkout de Wompi.
# En Vercel: https://<tu-dominio>. Déjala vacía en local: el código reescribe
# localhost → lvh.me automáticamente, porque el WAF de Wompi devuelve 403 a
# cualquier redirect-url local o privado (ver lib/checkout-origin.ts).
NEXT_PUBLIC_PUBLIC_URL=

# Wompi — llave pública del comercio (sandbox: empieza con pub_test_)
NEXT_PUBLIC_WOMPI_KEY=

# Secreto de eventos de Wompi (Dashboard → Desarrolladores → Secretos), para
# verificar la firma del webhook en app/api/wompi/webhook/route.ts
WOMPI_EVENTS_SECRET=

# Debe ser IDÉNTICO al INTERNAL_WEBHOOK_SECRET de server/.env
INTERNAL_WEBHOOK_SECRET=

# PIN del panel /admin (Fase 4) — el que le das a Daniel
FAMA_ADMIN_PIN=

# Secreto random para firmar la cookie de sesión de /admin (independiente del PIN, no lo cambies
# después de que Daniel inicie sesión o su cookie dejará de servir). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
