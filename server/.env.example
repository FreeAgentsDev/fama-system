PORT=2436

# Firestore (Firebase Console → Configuración del proyecto → Cuentas de servicio → Generar clave)
# Si estas 3 variables no están puestas, el server sigue funcionando en desarrollo con un
# almacén en memoria del proceso (ver FirestoreEventContract) — los datos NO persisten.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Wompi (sandbox hasta que Daniel apruebe pasar a producción)
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_INTEGRITY_SECRET=

# URL pública del server, usada por el webhook de Wompi en Next.js (Fase 3)
IRACA_URL=http://localhost:2436
